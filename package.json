{
  "name": "agentdata-mcp-server",
  "version": "3.0.0",
  "description": "AgentData MCP server: customer lists of B2B software for AI agents. Every company using a technology, how and when it was found, and the new customers. Needs an AgentData account.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "agentdata-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "serve": "tsc && node dist/index.js --http",
    "inspect": "tsc && npx @modelcontextprotocol/inspector node dist/index.js",
    "start": "node dist/index.js --http",
    "smoke": "tsc && node scripts/smoke.mjs",
    "e2e": "tsc && node scripts/e2e-local.mjs",
    "railway:build": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "start.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "remote-mcp",
    "agentdata",
    "customer-lists",
    "companies-using",
    "technographics",
    "tech-stack",
    "technology-lookup",
    "new-customers",
    "competitor-customers",
    "sales-intelligence",
    "revops",
    "b2b",
    "ai-agent",
    "claude",
    "claude-connector",
    "chatgpt",
    "cursor"
  ],
  "author": "AgentData <support@useagentdata.com> (https://useagentdata.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nick-timms/agentdata-mcp-server"
  },
  "homepage": "https://useagentdata.com/docs/mcp",
  "bugs": {
    "url": "https://github.com/nick-timms/agentdata-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18.17"
  }
}
