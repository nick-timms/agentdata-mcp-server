{
  "name": "agentdata-mcp-server",
  "version": "2.0.0",
  "description": "AgentData MCP server: free company data for AI agents. 128M companies with tech stacks, web signals, email addresses with verification status, people and switch signals, from Claude, ChatGPT, Cursor or any MCP client.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "agentdata-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "serve": "tsc && node dist/index.js --http",
    "inspect": "tsc && npx @modelcontextprotocol/inspector node dist/index.js",
    "start": "node dist/index.js --http",
    "smoke": "tsc && node scripts/smoke.mjs",
    "railway:build": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "start.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agentdata",
    "company-data",
    "tech-stack",
    "email-finder",
    "b2b",
    "sales-intelligence",
    "ai-agent",
    "claude",
    "cursor",
    "free"
  ],
  "author": "AgentData <support@agentdata.run> (https://agentdata.run)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nick-timms/agentdata-mcp-server"
  },
  "homepage": "https://agentdata.run/docs",
  "bugs": {
    "url": "https://github.com/nick-timms/agentdata-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18.17"
  }
}
