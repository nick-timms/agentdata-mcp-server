{
  "name": "agentdata-mcp-server",
  "version": "2.1.1",
  "description": "AgentData MCP server: company data for AI agents. Company profiles, tech stacks (technographics) and tool-switch signals for any business website with no key; email addresses with verification status and people with a free key. Works in Claude, ChatGPT, Cursor and any MCP client.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "agentdata-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "serve": "tsc && node dist/index.js --http",
    "inspect": "tsc && npx @modelcontextprotocol/inspector node dist/index.js",
    "start": "node dist/index.js --http",
    "smoke": "tsc && node scripts/smoke.mjs",
    "railway:build": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "start.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "remote-mcp",
    "agentdata",
    "company-data",
    "company-enrichment",
    "technographics",
    "tech-stack",
    "lead-generation",
    "sales-intelligence",
    "email-finder",
    "b2b",
    "ai-agent",
    "claude",
    "claude-connector",
    "chatgpt",
    "cursor",
    "free"
  ],
  "author": "AgentData <support@agentdata.run> (https://agentdata.run)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nick-timms/agentdata-mcp-server"
  },
  "homepage": "https://agentdata.run/docs",
  "bugs": {
    "url": "https://github.com/nick-timms/agentdata-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18.17"
  }
}
